{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwoKey Linux AI Assistant",
  "version": "1.0.22",
  "identifier": "dev.twokey.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "overlay",
        "title": "TwoKey",
        "url": "index.html",
        "width": 340,
        "height": 72,
        "minWidth": 340,
        "minHeight": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "center": false,
        "x": 24,
        "y": 24
      },
      {
        "label": "settings",
        "title": "TwoKey Einstellungen",
        "url": "index.html?view=settings",
        "width": 920,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
